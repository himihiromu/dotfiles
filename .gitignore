!/dot_config/obs-studio/basic/
/dot_config/obs-studio/basic/*
!/dot_config/obs-studio/basic/profiles/
!/dot_config/obs-studio/basic/scenes/
/dot_config/obs-studio/basic/profiles/*/*
!/dot_config/obs-studio/basic/profiles/*/basic.ini
!/dot_config/obs-studio/basic/profiles/*/basic.ini.tmpl
!/dot_config/obs-studio/basic/profiles/*/recordEncoder.json
!/dot_config/obs-studio/basic/profiles/*/recordEncoder.json.tmpl
/dot_config/obs-studio/basic/scenes/*
!/dot_config/obs-studio/basic/scenes/*.json
!/dot_config/obs-studio/basic/scenes/*.json.tmpl
