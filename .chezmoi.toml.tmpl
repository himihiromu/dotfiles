{{- $git_username := promptStringOnce . "git_username" "Git username" ""}}
{{ $is_desktop := promptBoolOnce . "is_desktop" "Install desktop GUI applications" }}
{{- $is_wsl := false }}
{{- if eq .chezmoi.os "linux" }}
{{- $is_wsl = promptBoolOnce . "is_wsl" "Is this a WSL environment" }}
{{- end }}
{{- $git_email := promptStringOnce . "git_email" "Git email" ""}}
{{- $all_pc_type := list "private_pc" "office_pc" -}}
{{- $setting_pc_type := promptChoiceOnce . "setting_pc_type" "Setting PC Type" $all_pc_type -}}

{{- $custom_nix_profiles := false }}
{{- $nix_home_profiles := list }}
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") }}
{{- $custom_nix_profiles = promptBoolOnce . "custom_nix_profiles" "Home Managerの追加機能を個別に選びますか" false }}
{{- if $custom_nix_profiles }}
{{- $profile_labels := dict
    "hyprland" "Hyprlandデスクトップ・Waybar・壁紙・ロック"
    "gaming" "ゲーム環境（Minecraft・Heroic）"
    "recording" "録画環境（OBS・Hyprlandキー連携）"
    "darwin" "macOS用ツール（Lima・skhd）"
}}
{{- $params := dict "os" .chezmoi.os "desktop" $is_desktop "wsl" $is_wsl "selected" (list) }}
{{- if hasKey . "nix_home_profiles" }}
{{- $_ := set $params "selected" .nix_home_profiles }}
{{- end }}
{{- $selection := includeTemplate "nix-home-profiles.json.tmpl" $params | fromJson }}
{{- if not (hasKey . "nix_home_profiles") }}
{{- $choices := list }}
{{- range $selection.available }}
{{- $choices = append $choices (index $profile_labels .) }}
{{- end }}
{{- $selected := promptMultichoice "追加機能を選択（Space:切替 / Enter:確定 / 未選択:追加なし）" $choices }}
{{- $extras := list }}
{{- range $selection.available }}
{{- if has (index $profile_labels .) $selected }}
{{- $extras = append $extras . }}
{{- end }}
{{- end }}
{{- $_ := set $params "selected" $extras }}
{{- $selection = includeTemplate "nix-home-profiles.json.tmpl" $params | fromJson }}
{{- end }}
{{- $nix_home_profiles = $selection.profiles }}
{{- end }}
{{- end }}

[data]
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") }}
    custom_nix_profiles = {{ $custom_nix_profiles }}
{{- if $custom_nix_profiles }}
    nix_home_profiles = {{ $nix_home_profiles | toToml }}
{{- end }}
{{- end }}
	machine_username = {{ env "USER" | quote }}
	git_username = {{ $git_username | quote }}
	is_desktop = {{ $is_desktop | quote }}
	is_wsl = {{ $is_wsl }}
	git_email = {{ $git_email | quote }}
	setting_pc_type = {{ $setting_pc_type | quote -}}
{{ if eq $setting_pc_type "office_pc" }}
{{- $proxy_ip := promptStringOnce . "proxy_ip" "Proxy Server IP Address" ""}}
	proxy_ip = {{ $proxy_ip | quote -}}
{{ end }}

{{ if eq .chezmoi.os "windows" }}
[cd]
	command = 'powershell'
{{ else if eq .chezmoi.os "darwin" }}
[cd]
	command = 'fish'
{{ else if eq .chezmoi.os "linux" }}
[cd]
	command = 'fish'
{{ end }}
